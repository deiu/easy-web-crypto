{
  "name": "easy-web-crypto",
  "version": "1.4.0",
  "description": "Webcrypto API wrapper for the browser",
  "author": "Andrei Sambra <andrei.sambra@gmail.com>",
  "license": "MIT",
  "keywords": [
    "webcrypto",
    "webcrypto api",
    "cryptography",
    "key derivation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deiu/easy-web-crypto.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cjs/web-crypto": {
      "types": "./dist/cjs/web-crypto.d.ts",
      "require": "./dist/cjs/web-crypto.js"
    },
    "./esm/web-crypto": {
      "types": "./dist/esm/web-crypto.d.mts",
      "import": "./dist/esm/web-crypto.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
